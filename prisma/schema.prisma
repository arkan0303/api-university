// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// ============================================
// KONTEN BERANDA (HOME PAGE ONLY)
// ============================================

// Model: HeroSection
// Fungsi: Menyimpan konten hero section di halaman BERANDA saja
// Digunakan di menu: BERANDA/HOME (halaman utama)
// Berisi: Judul besar, deskripsi, tombol CTA, background image/color
// Catatan: Hanya ada 1 record untuk halaman beranda
model HeroSection {
  id                Int      @id @default(autoincrement())
  judul             String
  // subjudul          String?
  deskripsi         String   
  // tombolTeks        String?  // "Pelajari Lebih Lanjut", "Daftar Sekarang", dst.
  // tombolLink        String?
  // backgroundImage   String?
  // backgroundColor   String?  // Hex color
  // textColor         String?  // Hex color
  // aktif             Boolean  @default(true)
  image             String
  status             String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("herosection")
}

// Model: StatistikBeranda
// Fungsi: Menyimpan angka-angka statistik di halaman BERANDA
// Digunakan di menu: BERANDA (bagian statistik)
// Contoh: "1,234 Mahasiswa", "95% Tingkat Kelulusan"
model StatistikBeranda {
  id                Int      @id @default(autoincrement())
  label             String   // "Total Mahasiswa", "Tingkat Kelulusan", dst.
  nilai             String   // "1,234", "95%", dst.
  ikon              String?  // Icon name atau URL
  deskripsi         String?
  urutan            Int      @default(0)
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("statistikberanda")
}

// ============================================
// KEPEGAWAIAN
// ============================================

// Model: Dosen
// Fungsi: Menyimpan data dosen tetap dan tidak tetap
// Digunakan di menu: Kepegawaian > Dosen
// Berisi: Biodata, pendidikan, publikasi, keahlian
model Dosen {
  id                Int      @id @default(autoincrement())
  nidn              String   @unique
  nama              String
  email             String
  telepon           String
  foto              String?
  jabatan           String   // "Dosen Tetap", "Dosen Luar Biasa", dst.
  pendidikan        String   // "S3 Hukum Pidana"
  universitasAsal   String?
  keahlian          Json // Array bidang keahlian
  jumlahPublikasi   Int      @default(0)
  biografi          String   
  penghargaan       Json // Array penghargaan
  minatPenelitian   Json // Array minat penelitian
  mataKuliah        Json // Array mata kuliah yang diampu
  scholar           String?  // Google Scholar URL
  scopus            String?  // Scopus URL
  sinta             String?  // SINTA URL
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("dosen")
}




// Model: Rekognisi
// Fungsi: Menyimpan data rekognisi/penghargaan institusi
// Digunakan di menu: Kemahasiswaan dan Alumni > Data Rekognisi
// Berisi: Akreditasi, sertifikasi, penghargaan institusi
model Rekognisi {
  id                Int      @id @default(autoincrement())
  judul             String
  kategori          String   // "Akreditasi", "Sertifikasi", "Penghargaan", dst.
  tingkat           String   // "Internasional", "Nasional", "Regional"
  tahun             Int
  pemberi           String
  deskripsi         String   
  dampak            String   
  kriteriaPenilaian Json // Array kriteria penilaian
  manfaat           Json // Array manfaat
  berlakuHingga     DateTime?
  foto              String?
  sertifikat        String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("rekognisi")
}




// Model: RekapitulasiSurvey
// Fungsi: Menyimpan rekapitulasi pengisian survey tracer study
// Digunakan di menu: Kemahasiswaan dan Alumni > Rekapitulasi Pengisian
// Berisi: Tingkat partisipasi per angkatan
// Relasi: Memiliki banyak KategoriRekapitulasi
model RekapitulasiSurvey {
  id                Int      @id @default(autoincrement())
  programStudi      String   // "S1 Hukum"
  angkatan          String   // "2021", "2022", dst.
  totalMahasiswa    Int
  totalResponden    Int
  tingkatPartisipasi Float   // Persentase
  
  kategori          KategoriRekapitulasi[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("rekapitulasisurvey")
}

// Model: KategoriRekapitulasi
// Fungsi: Menyimpan detail kelengkapan per kategori survey
// Digunakan di menu: Kemahasiswaan dan Alumni > Rekapitulasi Pengisian
// Berisi: Kategori data (pribadi, akademik, dll) dan kelengkapannya
// Relasi: Many-to-one dengan RekapitulasiSurvey
model KategoriRekapitulasi {
  id                Int      @id @default(autoincrement())
  rekapitulasiId    Int
  nama              String   // "Data Pribadi", "Data Akademik", dst.
  totalField        Int
  fieldTerisi       Int
  tingkatKelengkapan Float   // Persentase
  
  rekapitulasi      RekapitulasiSurvey @relation(fields: [rekapitulasiId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("kategorirekapitulasi")
}

// ============================================
// ARSIP - SURAT FAKULTAS
// ============================================

// Model: SuratMasuk
// Fungsi: Menyimpan arsip surat masuk ke fakultas
// Digunakan di menu: Arsip > Arsip Fakultas > Surat Masuk
// Berisi: Nomor surat, pengirim, perihal, isi, lampiran, disposisi
model SuratMasuk {
  id                Int      @id @default(autoincrement())
  nomorSurat        String   @unique
  perihal           String
  pengirim          String
  instansiPengirim  String
  tanggalDiterima   DateTime
  prioritas         String   // "Tinggi", "Sedang", "Rendah"
  status            String   @default("Baru") // "Baru", "Diproses", "Selesai"
  kategori          String   // "Undangan", "Pemberitahuan", "Permohonan", dst.
  isiSurat          String   
  lampiran          Json // Array URL lampiran
  disposisi         String?  
  catatan           String?  
  foto              String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("suratmasuk")
}

// Model: SuratKeluar
// Fungsi: Menyimpan arsip surat keluar dari fakultas
// Digunakan di menu: Arsip > Arsip Fakultas > Surat Keluar
// Berisi: Nomor surat, penerima, perihal, isi, lampiran, penandatangan
model SuratKeluar {
  id                Int      @id @default(autoincrement())
  nomorSurat        String   @unique
  perihal           String
  penerima          String
  instansiPenerima  String
  tanggalKirim      DateTime
  prioritas         String   // "Tinggi", "Sedang", "Rendah"
  status            String   @default("Draft") // "Draft", "Proses", "Terkirim"
  kategori          String   // "Undangan", "Pemberitahuan", "Permohonan", dst.
  isiSurat          String   
  lampiran          Json // Array URL lampiran
  namaPengirim      String
  jabatanPengirim   String
  catatan           String?  
  foto              String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("suratkeluar")
}

// ============================================
// KEKHUSUSAN (SPECIALIZATIONS)
// ============================================

// Model: Kekhususan
// Fungsi: Menyimpan data program kekhususan hukum
// Digunakan di menu: Kekhususan (Hukum Pidana, Hukum Perdata, Hukum Tata Negara)
// Berisi: Nama kekhususan, deskripsi, total SKS, statistik
// Relasi: Memiliki banyak MataKuliahKekhususan dan ProspekKarir
model Kekhususan {
  id                Int      @id @default(autoincrement())
  nama              String   @unique // "Hukum Pidana", "Hukum Perdata", "Hukum Tata Negara"
  slug              String   @unique // "pidana", "perdata", "tata-negara"
  deskripsi         String   
  totalSKS          Int      // 24 SKS
  totalMahasiswa    Int
  tingkatKelulusan  Float    // Persentase
  
  mataKuliah        MataKuliahKekhususan[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("kekhususan")
}

// Model: MataKuliahKekhususan
// Fungsi: Menyimpan data mata kuliah per kekhususan
// Digunakan di menu: Kekhususan (detail mata kuliah di setiap kekhususan)
// Berisi: Nama, kode, SKS, semester, topik bahasan
// Relasi: Many-to-one dengan Kekhususan
model MataKuliahKekhususan {
  id                Int      @id @default(autoincrement())
  kekhususanId      Int
  nama              String
  kode              String
  semester          Int
  sks               Int
  deskripsi         String   
  topikBahasan      Json // Array topik yang dibahas
  foto              String?
  
  kekhususan        Kekhususan @relation(fields: [kekhususanId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("matakuliahkekhususan")
}


