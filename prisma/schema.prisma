generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model HeroSection {
  id        Int      @id @default(autoincrement())
  urutan    String?
  image     String
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("herosection")
}

model StatistikBeranda {
  id        Int      @id @default(autoincrement())
  label     String
  nilai     String
  ikon      String?
  deskripsi String?
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statistikberanda")
}

model Dosen {
  id              Int      @id @default(autoincrement())
  nidn            String   @unique
  nama            String
  email           String
  telepon         String
  foto            String?
  jabatan         String
  pendidikan      String
  universitasAsal String?
  keahlian        Json
  jumlahPublikasi Int      @default(0)
  biografi        String
  penghargaan     Json
  minatPenelitian Json
  mataKuliah      Json
  scholar         String?
  scopus          String?
  sinta           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("dosen")
}

model Rekognisi {
  id                Int       @id @default(autoincrement())
  judul             String
  kategori          String
  tingkat           String
  tahun             Int
  pemberi           String
  deskripsi         String
  dampak            String
  kriteriaPenilaian Json
  manfaat           Json
  berlakuHingga     DateTime?
  foto              String?
  sertifikat        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("rekognisi")
}

model RekapitulasiSurvey {
  id                 Int                    @id @default(autoincrement())
  programStudi       String
  angkatan           String
  totalMahasiswa     Int
  totalResponden     Int
  tingkatPartisipasi Float
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  kategori           KategoriRekapitulasi[]

  @@map("rekapitulasisurvey")
}

model KategoriRekapitulasi {
  id                 Int                @id @default(autoincrement())
  rekapitulasiId     Int
  nama               String
  totalField         Int
  fieldTerisi        Int
  tingkatKelengkapan Float
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  rekapitulasi       RekapitulasiSurvey @relation(fields: [rekapitulasiId], references: [id], onDelete: Cascade)

  @@map("kategorirekapitulasi")
}

model SuratMasuk {
  id               Int      @id @default(autoincrement())
  nomorSurat       String   @unique
  perihal          String
  pengirim         String
  instansiPengirim String
  tanggalDiterima  DateTime
  prioritas        String
  status           String   @default("Baru")
  kategori         String
  isiSurat         String
  lampiran         Json
  disposisi        String?
  catatan          String?
  foto             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("suratmasuk")
}

model SuratKeluar {
  id               Int      @id @default(autoincrement())
  nomorSurat       String   @unique
  perihal          String
  penerima         String
  instansiPenerima String
  tanggalKirim     DateTime
  prioritas        String
  status           String   @default("Draft")
  kategori         String
  isiSurat         String
  lampiran         Json
  namaPengirim     String
  jabatanPengirim  String
  catatan          String?
  foto             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("suratkeluar")
}

model Kekhususan {
  id               Int                    @id @default(autoincrement())
  nama             String                 @unique
  slug             String                 @unique
  deskripsi        String
  totalSKS         Int
  totalMahasiswa   Int
  tingkatKelulusan Float
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  mataKuliah       MataKuliahKekhususan[]

  @@map("kekhususan")
}

model MataKuliahKekhususan {
  id           Int        @id @default(autoincrement())
  kekhususanId Int
  nama         String
  kode         String
  semester     Int
  sks          Int
  deskripsi    String
  topikBahasan Json
  foto         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  kekhususan   Kekhususan @relation(fields: [kekhususanId], references: [id], onDelete: Cascade)

  @@map("matakuliahkekhususan")
}

