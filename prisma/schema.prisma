// ============================================
// BERITA & PENGUMUMAN
// ============================================

// Model: Berita
// Fungsi: Menyimpan artikel berita fakultas
// Digunakan di menu: Beranda (untuk menampilkan berita terbaru)
// Berisi: Judul, konten, kategori, penulis, galeri foto
model Berita {
  id                Int      @id @default(autoincrement())
  judul             String?  
  konten            String ?  
  kategori          String ?   // "Akademik", "Kemahasiswaan", "Penelitian", dst.
  penulis           String ?
  tanggalPublikasi  DateTime ?
  foto              String ?
  galeri            Json ? 
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("berita")
}

// Model: Pengumuman
// Fungsi: Menyimpan pengumuman penting fakultas
// Digunakan di menu: Beranda (untuk menampilkan pengumuman)
// Berisi: Judul, konten, kategori, prioritas, masa berlaku
model Pengumuman {
  id                Int      @id @default(autoincrement())
  judul             String
  konten            String   
  kategori          String   // "Penting", "Akademik", "Kemahasiswaan", dst.
  prioritas         String   // "Tinggi", "Sedang", "Rendah"
  tanggalMulai      DateTime
  tanggalBerakhir   DateTime?
  lampiran          Json // Array URL lampiran
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pengumuman")
}



// ============================================
// TESTIMONI & FAQ
// ============================================

// Model: Testimoni
// Fungsi: Menyimpan testimoni dari mahasiswa/alumni
// Digunakan di menu: Beranda (untuk menampilkan testimoni)
// Berisi: Nama, jabatan, foto, konten testimoni, rating
model Testimoni {
  id                Int      @id @default(autoincrement())
  judul             String?
  nama              String?
  jabatan           String?   // "Alumni 2020", "Mahasiswa Aktif", dst.
  foto              String?
  galeri            Json? // Array URL foto
  konten            String?   
  kategori          String?
  note              String?   
  tanggalPublikasi  String?   
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("testimoni")
}
