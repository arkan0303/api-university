model StatistikAdvokatParalegal {
  id                Int      @id @default(autoincrement())
  paralegal            String?
  kasusDitangani            String?
  advokatAktif          String?
  tingkatKepuasan   String?
  slogan            String?
  deskripsi         String?

}



// Model: Fasilitas
// Fungsi: Menyimpan data fasilitas dan infrastruktur fakultas
// Digunakan di menu: Tentang > Fasilitas atau halaman Fasilitas
// Berisi: Nama, kategori, deskripsi, kapasitas, lokasi, foto
model Fasilitas {
  id                Int      @id @default(autoincrement())
  nama              String
  kategori          String   // "Ruang Kuliah", "Laboratorium", "Perpustakaan", "Ruang Seminar", dst.
  deskripsi         String   
  kapasitas         Int?     // Kapasitas orang (jika applicable)
  lokasi            String   // "Gedung A Lantai 2", "Kampus Utama", dst.
  luas              String?  // "100 m²", "50 m²", dst.
  fasilitas         Json // Array fasilitas yang tersedia: ["AC", "Proyektor", "WiFi", dst.]
  kondisi           String   @default("Baik") // "Baik", "Sedang", "Perlu Perbaikan"
  jamOperasional    String?  // "Senin-Jumat 08:00-16:00"
  penanggungJawab   String?  // Nama penanggung jawab
  kontakPJ          String?  // Kontak penanggung jawab
  foto              Json // Array URL foto fasilitas
  thumbnail         String?  // Foto utama untuk preview
  urutan            Int      @default(0)
  featured          Boolean  @default(false)
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// BERITA & PENGUMUMAN
// ============================================

// Model: Berita
// Fungsi: Menyimpan artikel berita fakultas
// Digunakan di menu: Beranda (untuk menampilkan berita terbaru)
// Berisi: Judul, konten, kategori, penulis, galeri foto
model Berita {
  id                Int      @id @default(autoincrement())
  judul             String?  
  konten            String ?  
  kategori          String ?   // "Akademik", "Kemahasiswaan", "Penelitian", dst.
  penulis           String ?
  tanggalPublikasi  DateTime ?
  foto              String ?
  galeri            Json ? 
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Model: Pengumuman
// Fungsi: Menyimpan pengumuman penting fakultas
// Digunakan di menu: Beranda (untuk menampilkan pengumuman)
// Berisi: Judul, konten, kategori, prioritas, masa berlaku
model Pengumuman {
  id                Int      @id @default(autoincrement())
  judul             String
  konten            String   
  kategori          String   // "Penting", "Akademik", "Kemahasiswaan", dst.
  prioritas         String   // "Tinggi", "Sedang", "Rendah"
  tanggalMulai      DateTime
  tanggalBerakhir   DateTime?
  lampiran          Json // Array URL lampiran
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// GALERI & MEDIA
// ============================================

// Model: Galeri
// Fungsi: Menyimpan galeri foto kegiatan fakultas
// Digunakan di menu: Beranda atau halaman Galeri
// Berisi: Judul, deskripsi, kategori, kumpulan foto
model Galeri {
  id                Int      @id @default(autoincrement())
  judul             String
  deskripsi         String?  
  kategori          String   // "Kegiatan", "Fasilitas", "Wisuda", dst.
  tanggal           DateTime
  foto              Json // Array URL foto
  featured          Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Model: Video
// Fungsi: Menyimpan video profil dan kegiatan fakultas
// Digunakan di menu: Beranda atau halaman Video
// Berisi: Judul, deskripsi, URL video, thumbnail
model Video {
  id                Int      @id @default(autoincrement())
  judul             String
  deskripsi         String?  
  kategori          String   // "Profil", "Kegiatan", "Tutorial", dst.
  urlVideo          String   // YouTube, Vimeo, atau URL lainnya
  thumbnail         String?
  durasi            String?  // "10:30"
  tanggalUpload     DateTime
  views             Int      @default(0)
  featured          Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// TESTIMONI & FAQ
// ============================================

// Model: Testimoni
// Fungsi: Menyimpan testimoni dari mahasiswa/alumni
// Digunakan di menu: Beranda (untuk menampilkan testimoni)
// Berisi: Nama, jabatan, foto, konten testimoni, rating
model Testimoni {
  id                Int      @id @default(autoincrement())
  judul             String?
  nama              String?
  jabatan           String?   // "Alumni 2020", "Mahasiswa Aktif", dst.
  foto              String?
  galeri            Json? // Array URL foto
  konten            String?   
  kategori          String?
  note              String?   
  tanggalPublikasi  String?   
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Model: FAQ
// Fungsi: Menyimpan pertanyaan yang sering diajukan
// Digunakan di menu: Halaman FAQ atau footer
// Berisi: Pertanyaan, jawaban, kategori
model FAQ {
  id                Int      @id @default(autoincrement())
  pertanyaan        String
  jawaban           String   
  kategori          String   // "Akademik", "Pendaftaran", "Beasiswa", dst.
  urutan            Int      @default(0)
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// KONTAK & PENGATURAN
// ============================================

// Model: InformasiKontak
// Fungsi: Menyimpan informasi kontak fakultas
// Digunakan di menu: Footer dan halaman Kontak
// Berisi: Alamat, telepon, email, jam operasional, maps
model InformasiKontak {
  id                Int      @id @default(autoincrement())
  jenis             String   @unique // "utama", "akademik", "kemahasiswaan", dst.
  alamat            String   
  telepon           Json
  email             Json
  fax               String?
  whatsapp          String?
  jamOperasional    String?
  maps              String?  // Google Maps embed URL
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Model: MediaSosial
// Fungsi: Menyimpan link media sosial fakultas
// Digunakan di menu: Footer dan header
// Berisi: Platform, URL, username
model MediaSosial {
  id                Int      @id @default(autoincrement())
  platform          String   @unique // "facebook", "instagram", "twitter", dst.
  url               String
  username          String?
  aktif             Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Model: PengaturanSitus
// Fungsi: Menyimpan pengaturan umum website
// Digunakan di menu: Seluruh website (logo, nama, favicon, dll)
// Berisi: Key-value pair untuk berbagai pengaturan
// Contoh: nama_fakultas, logo, favicon, warna_tema, dll
model PengaturanSitus {
  id                Int      @id @default(autoincrement())
  kunci             String   @unique // "nama_fakultas", "logo", "favicon", dst.
  nilai             String   
  tipe              String   // "text", "image", "number", "boolean", dst.
  deskripsi         String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// SISTEM/ADMIN
// ============================================

// Model: Pengguna
// Fungsi: Menyimpan data pengguna sistem (admin, staff)
// Digunakan di menu: Dashboard Admin (untuk login dan manajemen user)
// Berisi: Email, password, nama, role, foto
model Pengguna {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password          String
  nama              String
  role              String   // "Admin", "Staff", "Dosen", dst.
  foto              String?
  aktif             Boolean  @default(true)
  terakhirLogin     DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Model: LogAktivitas
// Fungsi: Menyimpan log aktivitas pengguna untuk audit trail
// Digunakan di menu: Dashboard Admin (untuk monitoring aktivitas)
// Berisi: Pengguna, aksi, entitas, deskripsi, IP, user agent
model LogAktivitas {
  id                Int      @id @default(autoincrement())
  penggunaId        Int?
  aksi              String   // "create", "update", "delete", "login", dst.
  entitas           String   // "Mahasiswa", "Berita", "Surat", dst.
  entitasId         Int?
  deskripsi         String   
  ipAddress         String?
  userAgent         String?
  
  createdAt         DateTime @default(now())
}
